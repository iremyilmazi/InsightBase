# Track only the active project and root handoff files.
/*
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/README.md
!/InsightBase-V2/

# Private workbook data and temporary files never belong in Git.
*.xlsx
*.xls
*.csv
*.tsv
*.DS_Store
__pycache__/
*.pyc
.openai/
*preview.jpg
no-currency-heading.jpg
.env
.env.*
demo-data.json

# Email demo deliverables contain a synthetic workbook and stay local.
InsightBase-V2/InsightBase-Mail-Windows/
InsightBase-V2/InsightBase-Windows-Demo.zip

# Local transfer variants; application source is maintained in V2.
InsightBase-V2/InsightBase-Mail-TXT/
InsightBase-V2/InsightBase-Windows-TXT.zip
InsightBase-V2/InsightBase-Windows-Live*/
InsightBase-V2/InsightBase-Windows-Live*.zip

InsightBase-V2/InsightBase-Windows-Demo/
InsightBase-V2/InsightBase-Windows-TXT/

# Private active local workbook; never commit or package.
InsightBase-V2/local-data/

# Publish only the five Raw-copyable Windows live files (never Excel or TXT/ZIP variants).
!InsightBase-V2/InsightBase-Windows-Live/
InsightBase-V2/InsightBase-Windows-Live/*
!InsightBase-V2/InsightBase-Windows-Live/BASLANGIC.md
!InsightBase-V2/InsightBase-Windows-Live/Baslat.cmd
!InsightBase-V2/InsightBase-Windows-Live/InsightBase.css
!InsightBase-V2/InsightBase-Windows-Live/InsightBase.html
!InsightBase-V2/InsightBase-Windows-Live/InsightBase.js
